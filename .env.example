# ==============================================================================
# ExamVault — Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://examvault_user:secret_password@localhost:5432/examvault_db?schema=public"

# Test Database (REQUIRED before running `npm test`).
# The test suites TRUNCATE tables. They refuse to run unless the target
# database name contains "test", so this must point at a scratch database.
TEST_DATABASE_URL="postgresql://examvault_user:secret_password@localhost:5432/examvault_test_db?schema=public"

# Session & Security
# REQUIRED in every environment. Generate with: openssl rand -base64 32
# The server refuses to start if this is missing, shorter than 32 characters,
# or left as the placeholder value below.
SESSION_SECRET="your-32-byte-base64-session-encryption-secret-here"
NODE_ENV="development"

# Dev/test-only auth bypass. MUST remain "false" (or unset) in production.
# When enabled in a non-production environment, requests may impersonate any
# user with the `x-actor-id` header. Never enable this on a real deployment.
ALLOW_ACTOR_IMPERSONATION="false"

# Private Object Storage (S3 / Cloudflare R2 / Supabase Storage)
# Exam files and payment screenshots are strictly private.
# STORAGE_PROVIDER="r2" or "s3" REQUIRES the credentials below — the server
# refuses to silently fall back to local disk and will abort at startup.
STORAGE_PROVIDER="local" # "r2" | "s3" | "local"
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID="your_s3_or_r2_access_key"
S3_SECRET_ACCESS_KEY="your_s3_or_r2_secret_key"
S3_BUCKET_NAME="examvault-private-storage"

# Platform Defaults (Configurable by Admin in Platform Settings)
SEMESTER_DEFAULT_PRICE_ETB=50
TELEBIRR_RECEIVER_NUMBER="0911234567"
TELEBIRR_RECEIVER_NAME="ExamVault Services"
CBE_ACCOUNT_NUMBER="1000123456789"
CBE_ACCOUNT_NAME="ExamVault Services"

# Rate Limiting & Upload Validation
MAX_UPLOAD_SIZE_MB=20
MAX_SCREENSHOT_SIZE_MB=5
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=900
